# Copy to .env and fill in. Never commit .env. Testnet keys only.

# From the AP4M participant portal (My setup)
AGENT_PRIVATE_KEY=0x...            # Agent wallet: opens Channels, signs Vouchers (needs XRP gas)
AGENT_ADDRESS=0x...
MERCHANT_PRIVATE_KEY=0x...         # Merchant payout wallet key (funds node bonds via scripts/fund-nodes.mjs)
MERCHANT_ADDRESS=0x...
PAYOUT_ADDRESS=0x...               # same as MERCHANT_ADDRESS
AP4M_API_URL=https://hackathon.ap4m.build
TEAM_NAME=YourTeam
# MERCHANT_ID=0x...                # defaults to the team merchant id in scripts/node.sh, scripts/demo2-merchant.sh and the coordinator

# Ask agent (scripts/ask.sh): the model runs on your laptop and only writes the programs the nodes run
ANTHROPIC_API_KEY=                 # optional; when empty the ask agent uses the local `claude` CLI (the demo setup)
ASK_MODEL=claude-sonnet-5-5        # model the ask agent uses to split a question into deterministic programs

# Generated by `node --env-file=.env scripts/keys.mjs` (also funds them with gas from the agent)
COORDINATOR_PRIVATE_KEY=0x...
COORDINATOR_ADDRESS=0x...
OPERATOR1_PRIVATE_KEY=0x...
OPERATOR1_ADDRESS=0x...
OPERATOR2_PRIVATE_KEY=0x...
OPERATOR2_ADDRESS=0x...
OPERATOR3_PRIVATE_KEY=0x...
OPERATOR3_ADDRESS=0x...
APPROVER_DEV_PRIVATE_KEY=0x...     # software stand-in for the hardware-wallet approver (dev only)
APPROVER_DEV_ADDRESS=0x...

# Optional
# QUICKNODE_RPC_URL=https://....xrpl-evm-testnet.quiknode.pro/...   # preferred RPC for every process when set
# QUICKNODE_WEBHOOK_SECRET=change-me   # required in the x-gradewire-secret header on POST /webhooks/quicknode
# WATCH_CHAIN=0   # coordinator: disable the 4 s RPC log poller so the Quicknode Stream is the only event source
# AP4M_RPC_URL=https://rpc.testnet.xrplevm.org   # fallback RPC when QUICKNODE_RPC_URL is unset
# COORDINATOR_URL=http://127.0.0.1:4500   # where nodes, verifiers, the ask agent and the trainer find the coordinator
# CHANNEL_ID=0x...                 # an open Channel for the paying agent (ask and trainer) to reuse
# CHANNEL_CAP=0.5                  # cap for Channels the paying agent opens, in RLUSD
# SAMPLING_RATE=0.5                # after a node's first FULL_SAMPLING_UNTIL verified jobs
# FULL_SAMPLING_UNTIL=3            # verified jobs sampled at 100% before SAMPLING_RATE applies
# PRICE_RLUSD=0.01                 # price per job (node)
# BOND_RLUSD=0.01                  # bond per node (node, scripts/fund-nodes.mjs)
# NODE_XRP=3                       # XRP gas sent to each node by scripts/fund-nodes.mjs
# ANCHOR_XRPL=0                    # disable native XRPL verdict anchoring
# XRPL_TESTNET_WS=wss://s.altnet.rippletest.net:51233

# Only for redeploying the contracts (contracts/script/Deploy.s.sol)
# RLUSD_TOKEN=0x27b57a9D0b8d24EB97259c4E2279e45255e016f3
# APPROVER_ADDRESS=0x...           # bond-withdrawal approver (APPROVER_DEV_ADDRESS for dev)
# TREASURY_ADDRESS=0x...           # receives the treasury share of slashed bonds
