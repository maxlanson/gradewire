# Copy to .env and fill in. Never commit .env. Testnet keys only.

# From the AP4M participant portal (My setup)
AGENT_PRIVATE_KEY=0x...            # Agent wallet: opens Channels, signs Vouchers (needs XRP gas)
AGENT_ADDRESS=0x...
MERCHANT_PRIVATE_KEY=0x...         # Merchant payout wallet key (funds grader bonds via scripts/fund-nodes.mjs)
MERCHANT_ADDRESS=0x...
PAYOUT_ADDRESS=0x...               # same as MERCHANT_ADDRESS
AP4M_API_URL=https://hackathon.ap4m.build
TEAM_NAME=YourTeam
# MERCHANT_ID=0x...                # defaults to the team merchant id in scripts/node.sh

# Generated by `node --env-file=.env scripts/keys.mjs` (also funds them with gas from the agent)
COORDINATOR_PRIVATE_KEY=0x...
COORDINATOR_ADDRESS=0x...
OPERATOR1_PRIVATE_KEY=0x...
OPERATOR1_ADDRESS=0x...
OPERATOR2_PRIVATE_KEY=0x...
OPERATOR2_ADDRESS=0x...
OPERATOR3_PRIVATE_KEY=0x...
OPERATOR3_ADDRESS=0x...
APPROVER_DEV_PRIVATE_KEY=0x...     # software stand-in for the hardware-wallet approver (dev only)
APPROVER_DEV_ADDRESS=0x...

# Optional
# QUICKNODE_RPC_URL=https://....xrpl-evm-testnet.quiknode.pro/...
# QUICKNODE_WEBHOOK_SECRET=change-me
# CHANNEL_ID=0x...                 # an open Channel for the trainer to reuse
# CHANNEL_CAP=0.5                  # cap for Channels the trainer opens, in RLUSD
# SAMPLING_RATE=0.5                # after a grader's first 3 verified jobs
# PRICE_RLUSD=0.01
# BOND_RLUSD=0.01
# ANCHOR_XRPL=0                    # disable native XRPL verdict anchoring
